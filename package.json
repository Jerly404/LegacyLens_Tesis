{
  "name": "codelens-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "start": "bash scripts/start-all.sh",
    "dev": "bash scripts/start-all.sh",
    "dev:all": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run start --workspace=frontend",
    "docker:start": "bash scripts/docker-all.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:all": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "lint:all": "npm run lint --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:all": "npm run test:backend && npm run test:frontend",
    "test": "npm run test:all",
    "verify:all": "npm run build:all && npm run lint:all && npm run test:all",
    "format:all": "prettier --write \"**/*.{ts,js,json,html,css,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.3.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "husky": "^9.0.11",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  }
}
